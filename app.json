{
  "expo": {
    "name": "Mes notes",
    "slug": "mes-notes",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mesnotes",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f7f3e8"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro"
    }
  }
}
